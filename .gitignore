# --- Данные: никогда не коммитятся ---
# Правила соревнования KKBox запрещают распространение данных (раздел 7.B).
# См. DATA.md.
data/

# Форматы выгрузок не должны попасть в репозиторий ниоткуда
*.csv
*.tsv
*.parquet
*.zip
*.gz
*.7z
*.dump
*.bak

# Исключение: агрегированные результаты, которые публикуются осознанно.
# Только после проверки, что в файле нет строк уровня отдельного пользователя.
!output/agg_*.csv

# --- Окружение ---
__pycache__/
.ipynb_checkpoints/
.env
*.log
.DS_Store
.idea/
.vscode/
venv/
.venv/
